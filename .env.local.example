# Supabase: Settings -> Database -> Connection string -> URI (Session pooler).
# Use the pooler host, not db.*.supabase.co — serverless hosts cannot use the
# direct connection. Keep the [YOUR-PROJECT-REF] username segment.
#   postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_ and never ship it to the
# browser — it bypasses row level security entirely.
#
# Set this and account creation works with no further setup. Without it, a
# signup depends on Supabase's "Confirm email" being switched OFF: with it on,
# GoTrue returns no session and emails a confirmation link, and a project with
# no SMTP provider attached cannot deliver that mail, so the account is created
# and then permanently unable to sign in.
#   Supabase dashboard -> Project Settings -> API Keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Signs the short-lived handles the app hands to the browser: the diff preview
# token (so the schema you reviewed is the schema that gets written) and nothing
# else user-visible. Optional - when unset it derives from
# SUPABASE_SERVICE_ROLE_KEY, which means every outstanding token is invalidated
# if you rotate that key. Set it explicitly so key rotation does not
# invalidate links or in-flight previews.
APP_SIGNING_SECRET=

# Per-IP hourly caps on the endpoints that cost money or database rows. The
# free-plan quota is per-cookie and can be reset just by clearing cookies, so
# these are what actually bound a single caller. Lower them once a metered AI
# key is in place; 0 or unset falls back to the built-in default.
RATE_LIMIT_GENERATE_PER_HOUR=30
# A refine is now two calls - one to preview, one to apply - so the default is
# 40 rather than 20.
RATE_LIMIT_REFINE_PER_HOUR=40
RATE_LIMIT_TRANSCRIBE_PER_HOUR=40
# Minting a read-only share link, and reading one. A share token carries 256
# bits of entropy so this is not about guessing; it bounds what one leaked
# link can do to the database.
RATE_LIMIT_SHARE_PER_HOUR=30
RATE_LIMIT_SHARE_VIEW_PER_HOUR=120

# Credential guessing, on a 15-minute window. Two budgets, and a caller must
# pass both: per-IP stops a single-source flood, per-account stops a botnet
# spreading attempts across one email. The per-IP number is the looser of the
# two because offices and campuses share one NAT address.
RATE_LIMIT_AUTH_IP=30
RATE_LIMIT_AUTH_EMAIL=10

# hCaptcha, applied to sign-in/sign-up and to share-link creation. Both values
# are needed: captcha is enforced only when the pair is present, so leaving them
# blank keeps the app working on its rate limits alone rather than blocking
# sign-in.
#   Create a site at https://dashboard.hcaptcha.com/sites
# The site key is public and ships to the browser. The secret is checked
# server-side only: a captcha that is verified solely in the browser proves
# nothing, because a bot posts straight to the API without loading the widget.
#   NEXT_PUBLIC_HCAPTCHA_SITE_KEY -> public site key (safe to expose)
#   HCAPTCHA_SECRET              -> secret key (NEVER prefix with NEXT_PUBLIC_)
# NEXT_PUBLIC_ values are inlined at build time, so changing one needs a rebuild.
# A captcha challenge is also only usable against the exact site key that issued
# it, so a mismatch between these two fails every attempt.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# /api/session mints a workspace row for cookie-less visitors, so it is the one
# unauthenticated endpoint that creates rows on a plain GET. Loosely capped to
# bound that growth; ordinary browsing is a handful of calls.
RATE_LIMIT_SESSION_PER_HOUR=300

# Paid plan upgrades. There is no payment provider wired up, so POST
# /api/session refuses to grant a paid plan unless ALLOW_PLAN_UPGRADES=true.
# Set ALLOWED_PRICE_EMAILS to a comma-separated allowlist to restrict it to
# specific accounts (those users must be signed in).
ALLOW_PLAN_UPGRADES=false
ALLOWED_PRICE_EMAILS=
